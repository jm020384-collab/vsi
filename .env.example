# ============================================================================
#  Базова конфігурація
# ============================================================================
# Публічна адреса сайту. З неї будуються не лише канонічні посилання,
# robots.txt і sitemap.xml, а й УСІ посилання в листах: підтвердження
# пошти, скидання пароля, сповіщення фахівцю про звернення.
#
# Після зміни домену оновіть її у Vercel і зробіть redeploy: значення з
# префіксом NEXT_PUBLIC_ вшивається у збірку, старий деплой його не бачить.
# Продакшн: https://vsi-therapy.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================================================
#  База даних — Neon Postgres (https://neon.tech)
# ============================================================================
# Створіть проєкт у Neon, виберіть EU-регіон (eu-central-1).
# Для preview-деплоїв увімкніть Neon branching.
#
# DATABASE_URL — pooled (з "-pooler" у hostname + ?pgbouncer=true) для застосунку
# DIRECT_DATABASE_URL — direct (без "-pooler") для prisma migrate
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/analyt_psy?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/analyt_psy?sslmode=require"

# ============================================================================
#  Auth.js v5  (https://authjs.dev)
# ============================================================================
# Згенерувати: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-32-byte-random-string"
# AUTH_URL у Auth.js v5 потрібен лише за нестандартного base path.
# Сайт живе в корені, тож на Vercel змінну можна взагалі не задавати —
# хост береться із заголовків запиту. Але якщо вона задана, після зміни
# домену її ОБОВ'ЯЗКОВО треба оновити, інакше вхід поведе на стару адресу.
AUTH_URL="http://localhost:3000"
# На Vercel виводиться автоматично; потрібен для інших хостингів.
AUTH_TRUST_HOST="true"

# ============================================================================
#  Resend  (https://resend.com)  — транзакційні листи
# ============================================================================
# Підтвердження пошти, скидання пароля, сповіщення фахівцю, підтвердження
# заявки на соціальну підтримку. Magic link не використовується: вхід лише
# через email і пароль.
RESEND_API_KEY="re_..."
# Відправник має бути на домені, підтвердженому в Resend (Domains → Add).
# Службова адреса onboarding@resend.dev — тестова: листи з неї доходять
# лише на власну адресу власника акаунта Resend. Для реальних користувачів
# реєстрація й скидання пароля з нею не працюють.
EMAIL_FROM="VSI <noreply@vsi-therapy.com>"

# ============================================================================
#  UploadThing  (https://uploadthing.com)
# ============================================================================
UPLOADTHING_TOKEN=""

# ============================================================================
#  Безпека
# ============================================================================
# Сіль для хешування IP (anti-spam, не сам IP)
IP_HASH_SALT="change-me-to-random-string"

# Ключ для шифрування ContactRequest.message (pgcrypto, спринт 3)
MESSAGE_ENCRYPTION_KEY="change-me-to-random-32-byte-key"

# ============================================================================
#  Cloudflare Turnstile  (captcha, спринт 3)
# ============================================================================
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ============================================================================
#  Sentry  (моніторинг, спринт 6)
# ============================================================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
