// Prisma schema — джерело істини моделі даних
// Документація: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled, через PgBouncer (?pgbouncer=true)
  directUrl = env("DIRECT_DATABASE_URL") // direct, для міграцій (без pooler)
}

// ============================================================================
//  Перерахування
// ============================================================================

enum Role {
  PATIENT
  THERAPIST
  ADMIN
}

enum TherapistStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SessionFormat {
  ONLINE
  OFFLINE
  BOTH
}

enum AgeGroup {
  CHILDREN
  TEENS
  ADULTS
}

enum WorkFormat {
  INDIVIDUAL
  COUPLES
  FAMILY
  GROUP
}

enum RequestStatus {
  NEW
  VIEWED
  REPLIED
  CLOSED
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ArticleKind {
  ARTICLE
  NOTE
  RESEARCH
  BOOK_REVIEW
  VIDEO
  AUDIO
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  DIPLOMA
  CERTIFICATE
  ID
  // Додаткове навчання: не завжди має диплом, часто взагалі без файлу
  COURSE
  MASTERCLASS
  CONFERENCE
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  NEEDS_UPDATE
}

enum EventType {
  LECTURE
  SEMINAR
  CONFERENCE
  SUPERVISION_GROUP
  INTERVISION_GROUP
  READING_GROUP
  TRAINING_PROGRAM
  WORKSHOP
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventAudience {
  PUBLIC // видно всім, зокрема неавторизованим
  PROFESSIONALS // видно лише залогіненим THERAPIST/ADMIN
  BOTH // свідомо для клієнтів і фахівців одночасно — видимість як PUBLIC
}

enum EventRegistrationStatus {
  SAVED
  REGISTERED
}

// ============================================================================
//  Auth.js (NextAuth v5) — стандартні моделі адаптера Prisma
// ============================================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  pendingEmail      String?   @unique
  emailVerified     DateTime?
  passwordHash      String?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  role              Role      @default(PATIENT)
  name              String?
  image             String?
  locale            String    @default("uk")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  therapist          TherapistProfile?
  articles           Article[]           @relation("AuthorArticles")
  accounts           Account[]
  sessions           Session[]
  eventRegistrations EventRegistration[]

  @@index([role])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Короткоживучий (30-60 хв), одноразовий токен для «забули пароль».
model PasswordResetToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
//  Профіль терапевта
// ============================================================================

model TherapistProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String          @unique
  fullName        String
  professionalTitle String? // Професійна кваліфікація, напр. «Психологиня, психотерапевтка, арт-терапевтка» — під фото
  photoUrl        String?
  bio             String          @db.Text // markdown
  city            String
  latitude        Float?
  longitude       Float?
  yearsExperience Int             @default(0)
  priceFrom       Int // у копійках/центах
  priceTo         Int?
  currency        String          @default("UAH")
  sessionFormat   SessionFormat   @default(BOTH)
  workingHours    String?
  contactEmail    String?
  contactPhone    String?
  // Месенджери — окремі номери/нік, бо часто відрізняються від основного телефону
  whatsapp        String?
  telegram        String?
  status          TherapistStatus @default(DRAFT)

  // Професійна позиція — «Мій простір»
  // approaches — фіксований список підходів (див. THERAPY_APPROACHES);
  // otherApproach/otherLanguage заповнюються, лише коли обрано «Інший…».
  approaches            String[]
  otherApproach         String?
  otherLanguage         String?
  analyticalOrientation String? // вільний опис підходу — лишається як додатковий контекст
  ageGroups             AgeGroup[]
  workFormats           WorkFormat[]
  professionalInterests String[]
  associations          String[] // професійні спільноти/членства
  supervisionStatus     String? // напр. «Проходжу регулярну супервізію з 2022»
  personalTherapyStatus String? // напр. «У особистому аналізі»

  // Модерація
  reviewNote String? @db.Text // коментар адміністратора при відхиленні

  // Контакт і доступність
  acceptingNewClients   Boolean  @default(true)
  acceptsRequestsViaVsi Boolean  @default(true)
  offersSupervision     Boolean  @default(false)
  offersGroupWork       Boolean  @default(false)
  website               String?
  socialLinks           String[] // вільні URL (LinkedIn, Instagram тощо)

  // tsvector для FTS — оновлюється тригером (див. міграцію)
  searchVector Unsupported("tsvector")?

  specializations TherapistSpecialization[]
  languages       TherapistLanguage[]
  documents       VerificationDocument[]
  requests        ContactRequest[]
  reviews         Review[]
  events          Event[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([city, status])
  @@index([status, publishedAt])
  @@index([deletedAt])
}

model Specialization {
  id          String  @id @default(cuid())
  slug        String  @unique
  nameUk      String
  description String?

  therapists TherapistSpecialization[]
}

model TherapistSpecialization {
  therapistId      String
  specializationId String

  therapist      TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  specialization Specialization   @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([therapistId, specializationId])
  @@index([specializationId])
}

model Language {
  code   String @id // "uk", "en", "pl", "ru"
  nameUk String

  therapists TherapistLanguage[]
}

model TherapistLanguage {
  therapistId  String
  languageCode String

  therapist TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  language  Language         @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@id([therapistId, languageCode])
  @@index([languageCode])
}

// ============================================================================
//  Верифікація
// ============================================================================

/// Запис освіти. Файл НЕ обовʼязковий: навчання можна просто описати
/// (заклад + спеціалізація) або позначити як «у процесі». Скан, коли він
/// є, лишається приватним — публічно видно лише текстовий опис.
model VerificationDocument {
  id          String           @id @default(cuid())
  therapistId String
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  fileUrl     String? // приватний bucket, доступ через підписані URL
  fileName    String?
  fileKey     String? // ключ у UploadThing/R2 для генерації signed URL

  institution    String? // заклад освіти
  specialization String? // спеціальність / напрям навчання
  yearFrom       Int?
  yearTo         Int?
  inProgress     Boolean @default(false) // навчання ще триває

  docType     DocumentType     @default(DIPLOMA)
  status      DocumentStatus   @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime         @default(now())

  @@index([therapistId])
}

// ============================================================================
//  Запит на консультацію
// ============================================================================

model ContactRequest {
  id            String           @id @default(cuid())
  therapistId   String
  therapist     TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  patientName   String
  patientEmail  String
  patientPhone  String?
  preferredTime String?
  message       String           @db.Text // pgcrypto-шифрування at-rest (рівень додатка)
  status        RequestStatus    @default(NEW)
  ipHash        String? // hash IP — не сам IP, для anti-spam
  consentGiven  Boolean          @default(false)
  consentAt     DateTime?
  createdAt     DateTime         @default(now())

  @@index([therapistId, status])
  @@index([createdAt])
}

// ============================================================================
//  Відгуки (без зіркового рейтингу — лише текст, з модерацією)
// ============================================================================

model Review {
  id            String           @id @default(cuid())
  therapistId   String
  therapist     TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  authorName    String
  authorEmail   String
  emailVerified Boolean          @default(false)
  content       String           @db.Text
  status        ReviewStatus     @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())

  @@index([therapistId, status])
}

// ============================================================================
//  Події — лекції, семінари, групи
// ============================================================================

model Event {
  id          String            @id @default(cuid())
  hostId      String?
  host        TherapistProfile? @relation(fields: [hostId], references: [id], onDelete: SetNull)
  title       String
  slug        String            @unique
  description String            @db.Text
  imageUrl    String?
  type        EventType
  format      SessionFormat     @default(ONLINE)
  language    String            @default("uk")
  startsAt    DateTime
  seatsTotal  Int?
  status      EventStatus       @default(DRAFT)
  audience    EventAudience     @default(PUBLIC)

  // Контакт для питань про подію (не обов'язково той самий, що в профілі) і вартість
  contactName  String?
  contactEmail String?
  contactPhone String?
  price        Int? // грн; порожньо — не вказано/безкоштовно

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
  @@index([hostId])
}

model EventRegistration {
  id      String                  @id @default(cuid())
  eventId String
  event   Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  EventRegistrationStatus @default(SAVED)

  // Реєстрація без акаунта — «Зареєструватися» відкрите для всіх, хто бачить
  // подію; «Зберегти» лишається лише для залогінених (userId).
  guestName  String?
  guestEmail String?
  guestPhone String?
  ipHash     String? // hash IP гостя — anti-spam, не сам IP

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, guestEmail])
}

// ============================================================================
//  Освітній контент
// ============================================================================

model Article {
  id       String        @id @default(cuid())
  slug     String        @unique
  title    String
  excerpt  String        @db.Text
  coverUrl String?
  content  String        @db.Text // MDX
  authorId String
  author   User          @relation("AuthorArticles", fields: [authorId], references: [id])
  status   ArticleStatus @default(DRAFT)
  kind     ArticleKind   @default(ARTICLE)

  abstract   String?  @db.Text
  topicSlug  String? // збіг зі slug теми з THEMES (без окремої реляційної моделі)
  references String[]
  mediaUrl   String?
  reviewNote String?  @db.Text // коментар адміністратора при поверненні з REVIEW у DRAFT

  tags         ArticleTag[]
  searchVector Unsupported("tsvector")?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([status, publishedAt])
  @@index([authorId])
}

model Tag {
  id     String @id @default(cuid())
  slug   String @unique
  nameUk String

  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

// ============================================================================
//  Audit log
// ============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // "therapist.approved", "article.published", "review.approved"
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}
